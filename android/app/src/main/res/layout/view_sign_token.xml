<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/token_glyph"
        android:layout_width="@dimen/token_glyph"
        android:layout_height="@dimen/token_glyph"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/token_badge"
        android:layout_width="@dimen/token_badge"
        android:layout_height="@dimen/token_badge"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:background="@drawable/shape_plate_hazard"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="9sp"
        android:textStyle="bold" />

</merge>
