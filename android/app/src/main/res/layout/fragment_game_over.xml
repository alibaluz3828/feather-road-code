<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_gradient">

    <ImageView
        android:id="@+id/result_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.30"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/result_hazard"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:alpha="0.10"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/pattern_hazard_diagonal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/result_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="@dimen/status_inset"
        app:layout_constraintBottom_toTopOf="@id/result_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:id="@+id/result_verdict"
                android:layout_width="@dimen/verdict_plate_width"
                android:layout_height="@dimen/verdict_plate_height"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/shape_plate_go"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="@dimen/space_m"
                android:paddingEnd="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="@color/ink" />

            <LinearLayout
                android:id="@+id/result_stars_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/result_star_one"
                    android:layout_width="@dimen/sprite_star_size"
                    android:layout_height="@dimen/sprite_star_size"
                    android:background="@drawable/shape_plate_dim"
                    android:contentDescription="@string/cd_star_locked"
                    android:padding="@dimen/space_s"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

                <ImageView
                    android:id="@+id/result_star_two"
                    android:layout_width="@dimen/sprite_star_size"
                    android:layout_height="@dimen/sprite_star_size"
                    android:layout_marginStart="@dimen/space_l"
                    android:background="@drawable/shape_plate_dim"
                    android:contentDescription="@string/cd_star_locked"
                    android:padding="@dimen/space_s"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

                <ImageView
                    android:id="@+id/result_star_three"
                    android:layout_width="@dimen/sprite_star_size"
                    android:layout_height="@dimen/sprite_star_size"
                    android:layout_marginStart="@dimen/space_l"
                    android:background="@drawable/shape_plate_dim"
                    android:contentDescription="@string/cd_star_locked"
                    android:padding="@dimen/space_s"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

            </LinearLayout>

            <com.AsDfGhJ.jMiKoLp.core.ui.CodeChipStripView
                android:id="@+id/result_recap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/code_strip_height"
                android:layout_marginTop="@dimen/space_xl" />

            <LinearLayout
                android:id="@+id/result_stats_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stat_card_height"
                android:layout_marginTop="@dimen/space_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                    android:id="@+id/result_stat_actions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                    android:id="@+id/result_stat_launches"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/chip_gap"
                    android:layout_weight="1" />

                <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                    android:id="@+id/result_stat_stars"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/chip_gap"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/result_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_sheet_top"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/result_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_play_again"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:text="@string/result_play_again"
            app:icon="@drawable/ic_arrow_right_bold" />

        <LinearLayout
            android:id="@+id/result_secondary_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_height"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_next_route"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/result_next_route" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:text="@string/result_menu" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
