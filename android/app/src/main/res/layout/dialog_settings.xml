<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_m"
    android:layout_marginEnd="@dimen/space_m"
    android:background="@drawable/shape_dialog_hard"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_xl">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/dialog_settings_title"
        android:textAppearance="@style/TextAppearance.App.Title" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/settings_haptics"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:layout_below="@id/settings_title"
        android:layout_marginTop="@dimen/space_m"
        android:letterSpacing="0.08"
        android:text="@string/settings_haptics"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/settings_contrast"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:layout_below="@id/settings_haptics"
        android:letterSpacing="0.08"
        android:text="@string/settings_contrast"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/settings_motion"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:layout_below="@id/settings_contrast"
        android:letterSpacing="0.08"
        android:text="@string/settings_motion"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/settings_rule"
        android:layout_width="match_parent"
        android:layout_height="@dimen/border_thick"
        android:layout_below="@id/settings_motion"
        android:layout_marginTop="@dimen/space_m"
        android:background="@color/outline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_reset"
        style="@style/Widget.App.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_below="@id/settings_rule"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/settings_reset" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_close"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_dialog_height"
        android:layout_below="@id/settings_reset"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/dialog_close" />

</RelativeLayout>
