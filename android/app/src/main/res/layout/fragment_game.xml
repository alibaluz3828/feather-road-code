<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <ImageView
        android:id="@+id/game_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.42"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_header_bar"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/status_inset"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_back"
            style="@style/Widget.App.Button.IconOnly"
            android:layout_width="@dimen/button_icon_size"
            android:layout_height="@dimen/button_icon_size"
            android:contentDescription="@string/cd_back"
            app:icon="@drawable/ic_arrow_left_bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/game_route_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/game_code_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/game_actions_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_actions"
                android:textAppearance="@style/TextAppearance.App.Label" />

            <TextView
                android:id="@+id/game_actions_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Numeric"
                android:textColor="@color/accent_primary"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

    <com.AsDfGhJ.jMiKoLp.core.ui.CodeChipStripView
        android:id="@+id/game_code_strip"
        android:layout_width="0dp"
        android:layout_height="@dimen/code_strip_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header" />

    <TextView
        android:id="@+id/game_coach"
        android:layout_width="0dp"
        android:layout_height="@dimen/coach_banner_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/shape_coach_banner"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/game_coach"
        android:textAllCaps="true"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_code_strip" />

    <com.AsDfGhJ.jMiKoLp.core.ui.RouteBoardView
        android:id="@+id/game_board"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/cd_board"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/game_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_coach"
        app:layout_constraintVertical_bias="0.30"
        app:layout_goneMarginTop="@dimen/space_l" />

    <LinearLayout
        android:id="@+id/game_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/game_stat_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stat_strip_height"
            android:layout_marginBottom="@dimen/space_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                android:id="@+id/game_stat_launches"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                android:id="@+id/game_stat_signs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/chip_gap"
                android:layout_weight="1" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_go"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:letterSpacing="0.26"
            android:text="@string/game_launch"
            android:textSize="22sp"
            app:icon="@drawable/ic_go_chevron" />

        <LinearLayout
            android:id="@+id/game_tray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sign_tray_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_block_surface"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/space_s" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
