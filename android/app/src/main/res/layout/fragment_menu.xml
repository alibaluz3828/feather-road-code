<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/menu_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_menu_art"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_scrim"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/scrim_menu_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/menu_route_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/menu_chip_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/status_inset"
        android:background="@drawable/shape_chip_hard"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:textAllCaps="true"
        android:textColor="@color/accent_primary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_settings"
        style="@style/Widget.App.Button.IconOnly"
        android:layout_width="@dimen/button_icon_size"
        android:layout_height="@dimen/button_icon_size"
        android:layout_marginTop="@dimen/status_inset"
        android:layout_marginEnd="@dimen/screen_margin"
        android:contentDescription="@string/cd_settings"
        app:icon="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_sheet_fade"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/scrim_menu_bottom"
        app:layout_constraintBottom_toTopOf="@id/menu_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menu_sheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_sheet_top"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/app_title"
            android:textAppearance="@style/TextAppearance.App.Headline" />

        <TextView
            android:id="@+id/menu_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:letterSpacing="0.16"
            android:text="@string/menu_tagline"
            android:textAllCaps="true"
            android:textColor="@color/accent_cool"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/menu_stats_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stat_card_height"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                android:id="@+id/menu_stat_routes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                android:id="@+id/menu_stat_stars"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/chip_gap"
                android:layout_weight="1" />

            <com.AsDfGhJ.jMiKoLp.core.ui.StatCardView
                android:id="@+id/menu_stat_best"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/chip_gap"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/menu_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.20"
            android:text="@string/menu_disclaimer"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_play"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:layout_marginTop="14dp"
            android:text="@string/menu_play"
            app:icon="@drawable/ic_arrow_right_bold" />

        <LinearLayout
            android:id="@+id/menu_secondary_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_height"
            android:layout_marginTop="@dimen/space_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_route_map"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/menu_route_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_sign_guide"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:text="@string/menu_sign_guide" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
